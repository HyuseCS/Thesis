<mxfile host="app.diagrams.net"><diagram id="frameworks" name="Frameworks"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1418" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Baseline: Hojaji et al. (2026)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="360" height="34" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Proposed framework&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="360" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Raw MoTeC telemetry&lt;/b&gt;&lt;br&gt;ACC v1.9, 50 Hz, Laguna Seca, McLaren 720S GT3&lt;br&gt;135 drivers, 1,180 laps" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Segment-level telemetry, Hojaji et al. (2024)&lt;/b&gt;&lt;br&gt;ACC, Brands Hatch, McLaren 720S GT3&lt;br&gt;165 drivers, 817 laps after cleaning" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;remove in/out laps, |z| &amp;gt; 3 outliers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="360" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;remove out-laps and invalid laps, |z| &amp;gt; 3 across all laps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="170" width="360" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Microsector segmentation&lt;/b&gt;&lt;br&gt;20 microsectors (10 corners, 10 straights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="360" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Microsector segmentation&lt;/b&gt;&lt;br&gt;19 microsectors (9 corners, 10 straights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="256" width="360" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Train / test split (70 / 30) by driver&lt;/b&gt;&lt;br&gt;+ external test set: new Brands Hatch laps (ACC v1.10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#3d7a2a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="342" width="360" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Performance stratification&lt;/b&gt;&lt;br&gt;K-Means on lap time (Fast / Medium / Slow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="360" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Performance stratification&lt;/b&gt;&lt;br&gt;K-Means on lap time; Fast cluster = reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="428" width="360" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Global feature selection&lt;/b&gt;&lt;br&gt;Pearson filter, then XGBoost / RF / SVM classifiers&lt;br&gt;XGBoost importance for predicting the lap's performance group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="360" height="88" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Microsector-level feature selection&lt;/b&gt;&lt;br&gt;control KPIs of microsector n ranked against Δt&lt;sub&gt;n&lt;/sub&gt; and v&lt;sub&gt;exit,n&lt;/sub&gt;&lt;br&gt;(v&lt;sub&gt;entry,n&lt;/sub&gt; as covariate); top K = 10, common to all microsectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f5fa8;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="514" width="360" height="88" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Chained surrogate model&lt;/b&gt;&lt;br&gt;one multi-output XGBoost: f&lt;sub&gt;ML&lt;/sub&gt;(s&lt;sub&gt;n&lt;/sub&gt;, v&lt;sub&gt;entry,n&lt;/sub&gt;, n) → (Δt&lt;sub&gt;n&lt;/sub&gt;, v&lt;sub&gt;exit,n&lt;/sub&gt;)&lt;br&gt;validated by grouped CV, test set, lap rollout, external test set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f5fa8;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="632" width="360" height="88" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Genetic algorithm&lt;/b&gt;&lt;br&gt;pop 120, 200 gens, tournament (3), two-point crossover 0.8,&lt;br&gt;Gaussian mutation 0.15 (σ 0.05), elitism 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58900;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="360" height="88" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Genetic algorithm (unchanged)&lt;/b&gt;&lt;br&gt;same operators and settings as Hojaji et al. (2026)&lt;br&gt;random initialization within training-lap ranges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58900;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="750" width="360" height="88" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Fitness = T + λP&lt;/b&gt;&lt;br&gt;T = Σ linearly scaled microsector times, clamped to 90–105%&lt;br&gt;&lt;i&gt;each microsector evaluated independently&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="360" height="88" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Coupled fitness = T + λP&lt;/b&gt;&lt;br&gt;v&lt;sub&gt;entry,1&lt;/sub&gt; fixed;  v&lt;sub&gt;entry,n+1&lt;/sub&gt; = v&lt;sub&gt;exit,n&lt;/sub&gt;;  T = Σ Δt&lt;sub&gt;n&lt;/sub&gt;&lt;br&gt;&lt;i&gt;exit state carried into the next microsector&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f5fa8;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="868" width="360" height="88" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;idealized microsector KPIs" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="360" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;per-microsector KPI targets as coaching instructions" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="986" width="360" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Evaluation (ablation)&lt;/b&gt;&lt;br&gt;coupled vs microsector-independent fitness, 30 paired seeds&lt;br&gt;both scored by the chained surrogate; Wilcoxon signed-rank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#3d7a2a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1072" width="360" height="88" as="geometry"/></mxCell><mxCell id="c23" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" style="endArrow=block;html=1;rounded=0;strokeColor=#555555;strokeWidth=1;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="422" y="912.0"/><mxPoint x="422" y="794.0"/></Array></mxGeometry></mxCell><mxCell id="c31" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1" source="c7" 